# ==========================================
# PG Finder NMIET - Cloud Database Environment Config
# ==========================================

# Supabase Cloud Project URL
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=

# Supabase Anon Public API Key or Service Role Key
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys
SUPABASE_ANON_KEY=

# Server Port (optional, default: 3000)
PORT=3000

